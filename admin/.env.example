# ===== 服务端口 =====
PORT=3002
APP_PORT=3002

# ===== 数据库（SQLite 单文件，生产务必挂载持久卷） =====
# 容器内默认 /data/pet-garden.db；
# 裸机/传统部署务必改成服务器上真实存在的目录，如 /www/wwwroot/petgarden/data/pet-garden.db
# 详细说明见 docs/DEPLOY-PRODUCTION.md
SQLITE_PATH=../db/pet-garden.db

# ===== 安全（生产环境务必修改） =====
# JWT 签名密钥，可用 `openssl rand -hex 32` 生成；缺失时生产模式启动会报错
TOKEN_SECRET=请替换为随机长字符串
# 管理员后台密码（默认 admin!@#$）
ADMIN_DEFAULT_PASSWORD=请替换为强密码

# ===== 认证限流（同一 IP） =====
AUTH_RATE_LIMIT_ENABLED=true
AUTH_REGISTER_RATE_LIMIT_MAX=1
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ===== 是否生成演示/游览数据（生产设为 1 关闭） =====
DISABLE_DEMO=1

# ===== 灵犀计划（VIP）收款联系方式（前端构建时注入，docker build --build-arg 传入） =====
# 由部署者自行填写；留空则不展示私人微信，仅提示“联系系统管理员”
VITE_ADMIN_WECHAT_PHONE=
VITE_WECHAT_PAY_QR_URL=

# ===== 家长端域名（用于生成邀请链接） =====
# 教师端“邀请家长”复制的链接基址，例如 https://parent.example.com
# 实际链接会拼接为 {PARENT_APP_BASE_URL}/?classId={班级ID}
# 留空则教师端无法生成邀请链接（链接完全由此配置决定，无兜底默认值）
# 生产环境应与「家长端」域名一致，详见 docs/DEPLOY-PRODUCTION.md
PARENT_APP_BASE_URL=https://nest.lemonlab.top